# Copy to .env and adjust. Every value below is optional in demo mode.

APP_ENV=development
LOG_LEVEL=INFO
DATA_DIR=data

# Demo mode searches a bundled offline corpus. Set to false to use a real provider.
DEMO_MODE=true
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Workflow limits
MAX_SEARCH_QUERIES=4
MAX_RESULTS_PER_QUERY=5
MAX_SOURCES=10
MIN_SOURCES=2
SEARCH_TIMEOUT_SECONDS=20
SEARCH_MAX_RETRIES=2
SEARCH_RETRY_BACKOFF_SECONDS=0.5

# Documents (PDF upload, chunking, retrieval)
MAX_UPLOAD_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=100
# sentence-transformers (semantic, downloads ~90 MB once) or hashing (lexical, offline baseline)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCUMENT_TOP_K=3
MAX_DOCUMENT_SOURCES=6
DOCUMENT_MIN_SCORE=0.25
# Conservative fallback when no candidate reaches DOCUMENT_MIN_SCORE. Disabled unless lower.
DOCUMENT_FALLBACK_MIN_SCORE=0.18

# Vector store: faiss (local files under DATA_DIR/documents) or pgvector (Supabase)
VECTOR_STORE=faiss
# Supabase > Project Settings > Database > Connection string. Secret: keep it in .env only.
SUPABASE_DB_URL=
PGVECTOR_TABLE=document_chunks

# Local LLM: used by the notebook, and by the API only for analyze=true requests.
# The API never loads it at startup.
LLM_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
LLM_DEVICE=auto
ANALYSIS_MAX_SOURCES=6
ANALYSIS_SOURCE_CHARS=600
ANALYSIS_MAX_NEW_TOKENS=512
ANALYSIS_TIMEOUT_SECONDS=180
LLM_LOAD_TIMEOUT_SECONDS=900
ANALYSIS_MAX_REVISIONS=1
VERIFIER_LLM_REVIEW=true
VERIFIER_MAX_REVIEWS=15
